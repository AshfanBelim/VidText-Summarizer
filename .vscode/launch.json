{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run app.py (low-resource: tiny + t5-base)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": { "WHISPER_MODEL": "tiny", "T5_MODEL": "t5-base" }
    }
  ]
}
